@using myshop.Web.Controllers
@model List<OrderResponse>
@{
	ViewData["Title"] = "Orders";
}

<div class="container py-5">

	<div class="d-flex justify-content-between align-items-center mb-4 flex-wrap gap-3">
		<div>
			<h2 class="mb-1">Orders</h2>
			<p class="text-muted mb-0">Manage and track all customer orders</p>
		</div>
		<span class="badge badge-primary rounded-pill px-3 py-2 fs-small">
			@Model.Count Total Order@(Model.Count == 1 ? "" : "s")
		</span>
	</div>

	@if (!Model.Any())
	{
		<div class="card">
			<div class="card-body text-center py-5">
				<h5 class="text-muted mb-1">No orders yet</h5>
				<p class="text-muted mb-0">Orders placed by customers will show up here.</p>
			</div>
		</div>
	}
	else
	{
		<div class="card">
			<div class="table-hover overflow-auto">
				<table class="table table-hover mb-0">
					<thead>
						<tr>
							<th>Order #</th>
							<th>Customer</th>
							<th>Phone</th>
							<th>City</th>
							<th>Items</th>
							<th>Total</th>
							<th>Status</th>
							<th>Date</th>
							<th class="text-end">Action</th>
						</tr>
					</thead>
					<tbody>
						@foreach (var order in Model)
						{
							var statusClass = order.Status switch
							{
								"Pending" => "badge-warning",
								"Paid" or "Completed" => "badge-success",
								"Cancelled" => "badge-danger",
								_ => "badge-secondary"
							};

							<tr>
								<td class="fw-semibold text-dark">#@order.Id</td>
								<td>@order.CustomerName</td>
								<td class="text-muted">@order.Phone</td>
								<td class="text-muted">@order.City</td>
								<td class="text-muted">@order.OrderItems.Count item@(order.OrderItems.Count == 1 ? "" : "s")</td>
								<td class="fw-semibold text-primary">@order.Total.ToString("C")</td>
								<td>
									<span class="badge @statusClass rounded-pill">@order.Status</span>
								</td>
								<td class="text-muted small">@order.CreatedAt.ToString("MMM dd, yyyy")</td>
								<td class="text-end">
									<a asp-action="@nameof(OrderController.Details)" asp-route-id="@order.Id" class="btn btn-outline-primary btn-sm">
										View Details
									</a>
								</td>
							</tr>
						}
					</tbody>
				</table>
			</div>
		</div>
	}

</div>
