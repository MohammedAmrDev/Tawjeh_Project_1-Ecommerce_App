<!DOCTYPE html>
<html lang="en">
<head>
	<meta charset="utf-8" />
	<meta name="viewport" content="width=device-width, initial-scale=1.0" />
	<title>@ViewData["Title"] - ShopHub</title>

	<link rel="preconnect" href="https://fonts.googleapis.com">
	<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
	<link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&display=swap" rel="stylesheet">
	<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css" />
	<link rel="stylesheet" href="~/css/modern.css" asp-append-version="true" />
	<link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
	<link rel="stylesheet" href="~/myshop.Web.styles.css" asp-append-version="true" />
	<style>
		body {
			margin: 0;
			animation: fadeIn 0.8s ease;
		}

		@@keyframes fadeIn {
			from { opacity: 0; }
			to { opacity: 1; }
		}

		.cart-items-num:empty {
			display: none;
		}

		.products-container span.msg {
			color: var(--color-text-dim);
			display: none;
			margin: auto;
			font-size: 4em;
		}
		.products-container:not(:has(.product-card)) span.msg {
			display: block;
		}
		.products-container:not(:has(.product-card)) + div .container .pagination {
			display: none;
		}
	</style>
</head>

<body class="d-flex flex-column min-vh-100">
	<header class="site-header">
		<div class="container">
			<a class="site-logo" asp-controller="Home" asp-action="Index">ShopHub</a>

			@if (!Context.Request.Path.ToString().Contains("/Account/"))
			{
				<button class="site-hamburger" id="siteHamburger" aria-label="Toggle navigation">
					<span></span>
					<span></span>
					<span></span>
				</button>

				<div class="site-search">
					<form action="@Context.Request.QueryString" method="get">
						<input type="search" name="searchBy" value="@Context.Request.Query["searchBy"].ToString()" placeholder="Search products..." aria-label="Search">
						@foreach (var query in Context.Request.Query)
						{
							if (query.Key != "pageIndex" && query.Key != "searchBy")
							{
								<input type="hidden" name="@query.Key" value="@query.Value" />
							}
						}
					</form>
				</div>
			
				<nav class="site-nav" id="siteNav">
					<ul class="site-nav-list">
						<li>
							<a asp-controller="Home" asp-action="Index" class="nav-link @(Context.Request.Path == "/" ? "active" : "")">Products</a>
						</li>
					    <li>
							<a asp-controller="Cart" asp-action="Index" class="nav-link @(Context.Request.Path.ToString().Contains("Cart") ? "active" : "")">
							    <i class="fa-solid fa-cart-shopping"></i> Cart
							    <span class="cart-badge" id="cartItemsNum">@ViewData["CartItemsNum"]</span>
						    </a>
					    </li>
						@if (User.Identity is not null && User.Identity.IsAuthenticated)
						   {
							  <li>
								 <a asp-controller="Order" asp-action="Index" class="nav-link @(Context.Request.Path.ToString().Contains("Order") ? "active" : "")">
									<i class="fa-solid fa-box-open"></i> My Orders
								 </a>
							  </li>
						   }
						</ul>
				</nav>
			}

			<div class="site-auth">
				<partial name="_LoginPartial" />
			</div>
		</div>
	</header>

	<main class="flex-grow-1 site-main">
		@RenderBody()
	</main>

	<footer class="site-footer">
		<div class="container">
			&copy; @DateTime.Now.Year - ShopHub. All rights reserved.
		</div>
	</footer>

	<script src="~/lib/jquery/dist/jquery.min.js"></script>
	<script src="~/js/modern.js" asp-append-version="true"></script>
	<script src="~/js/site.js" asp-append-version="true"></script>
	<script src="~/plugins/sweetalert2/sweetalert2.all.min.js"></script>

	@await RenderSectionAsync("Scripts", required: false)

</body>
</html>
