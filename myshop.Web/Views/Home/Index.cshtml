@using System.Text
@using System.Web
@model HomeViewModel

@{
	var allRoutes = Context.Request.Query.ToDictionary(q => q.Key, q => q.Value.ToString());
	string? selectedCategoryId = Context.Request.Query["categoryId"];
	bool isDesc = Convert.ToBoolean(Context.Request.Query["isDesc"]);
}

@functions {
	public string QueryStringUrlGenerator(string key, string? value)
	{
		var allRouteCopy = Context.Request.Query.ToDictionary(q => q.Key, q => q.Value.ToString());
		StringBuilder queryString = new("?");
		allRouteCopy.Remove("pageIndex");

		if (value is not null)
		{
			if (allRouteCopy.ContainsKey(key))
				allRouteCopy[key] = value;
			else
				queryString.Append($"{key}={value}&");
		}
		else
		{
			allRouteCopy.Remove(key);
		}

		foreach (var kvp in allRouteCopy)
		{
			queryString.Append($"{kvp.Key}={kvp.Value}&");
		}

		return Context.Request.Path + queryString.ToString()[..^1];
	}
}

<div class="categories-filter">
	<div class="container d-flex justify-content-between align-items-center">
		<div class="filter-tabs">
			<a class="nav-link @(string.IsNullOrEmpty(selectedCategoryId) ? "active" : "")" href="@QueryStringUrlGenerator("categoryId", null)">All</a>
			@foreach (var category in Model.Categories)
			{
				<a class="nav-link @(selectedCategoryId == category.Id.ToString() ? "active" : "")" href="@QueryStringUrlGenerator("categoryId", category.Id.ToString())">@category.Name</a>
			}
		</div>
		<div class="filter-actions">
			@if (!string.IsNullOrEmpty(Context.Request.Query["sortBy"].ToString()))
			{
				<a class="btn btn-outline-secondary btn-sm" href="@QueryStringUrlGenerator("isDesc", (!isDesc).ToString())">
					@(isDesc ? "Asc" : "Desc")
				</a>
			}
			<div class="dropdown">
				<button class="btn btn-primary dropdown-toggle" type="button" id="sortDropdown" data-bs-toggle="dropdown" aria-haspopup="true" aria-expanded="false">Sort By</button>
				<div class="dropdown-menu" aria-labelledby="sortDropdown">
					<a class="dropdown-item" href="@QueryStringUrlGenerator("sortBy", nameof(Product.Price))">Price</a>
					<a class="dropdown-item" href="@QueryStringUrlGenerator("sortBy", nameof(Product.Name))">Name</a>
				</div>
			</div>
			<div class="dropdown">
				<button class="btn btn-primary dropdown-toggle" type="button" id="countDropdown" data-bs-toggle="dropdown" aria-haspopup="true" aria-expanded="false">Number of products</button>
				<div class="dropdown-menu" aria-labelledby="countDropdown">
					<a class="dropdown-item" href="@QueryStringUrlGenerator("length", "5")">5</a>
					<a class="dropdown-item" href="@QueryStringUrlGenerator("length", "10")">10</a>
					<a class="dropdown-item" href="@QueryStringUrlGenerator("length", "15")">15</a>
				</div>
			</div>
		</div>
	</div>
</div>


<div class="p-5 products-container">
	<div class="container d-flex flex-wrap gap-4">
		@foreach (var product in Model.Products)
		{
			<div class="product-card">
				<div class="product-image">
					<img src='@product.ImageURL' alt="@product.Name">
				</div>
				<div class="product-info">
					<h5>@product.Name</h5>
					<p>@product.Description</p>
					<div class="product-footer">
						<span class="price">$@product.Price</span>
						<button class="btn btn-primary btn-sm" onclick="addToCart(@product.Id, '@product.Name', @product.Price, '@Html.Raw(HttpUtility.JavaScriptStringEncode(product.ImageURL))')">Add to Cart</button>
					</div>
					<a class="btn-link small mt-3 d-inline-block" asp-controller="Home" asp-action="ProductDetails" asp-route-id="@product.Id">View Details</a>
				</div>
			</div>
		}
		<span class="msg">No Products To Show</span>
	</div>
</div>

<div>
	<div class="container d-flex justify-content-center">
		<ul class="pagination">
			@if (Model.CurretPageIndex > 0)
			{
				<li class="page-item">
					<a class="page-link" href="@QueryStringUrlGenerator("pageIndex", (Model.CurretPageIndex - 1).ToString())">Previous</a>
				</li>
			}
			else
			{
				<li class="page-item disabled">
					<a class="page-link" href="#">Previous</a>
				</li>
			}


			@foreach (int? index in Model.PageIndexsList)
			{
				if (index is not null)
				{
					<li class="page-item @((index - 1) == Model.CurretPageIndex ? "active" : "")"><a class="page-link" href="@QueryStringUrlGenerator("pageIndex", (index - 1).ToString())">@index</a></li>
				}
				else
				{
					<li class="page-item disabled"><a class="page-link">...</a></li>
				}
			}


			@if (Model.CurretPageIndex < Model.PagesNumber - 1)
			{
				<li class="page-item">
					<a class="page-link" href="@QueryStringUrlGenerator("pageIndex", (Model.CurretPageIndex + 1).ToString())">Next</a>
				</li>
			}
			else
			{
				<li class="page-item disabled">
					<a class="page-link" href="#">Next</a>
				</li>
			}

		</ul>
	</div>
</div>


@section Scripts {
	<script>
		function addToCart(productId, productName, price, imageUrl) {
		  const product = {
			 productId,
			 productName,
			 price,
			  imageUrl
		  };

		  fetch('Cart/Add', {
			  method: 'POST',
			  headers: { 'content-type': 'application/json' },
			  body: JSON.stringify(product)
		  }).then(response => {
			  if (!response.ok) console.error(response.status);
			  return response.json();
		  }).then(data => {
			  document.getElementById('cartItemsNum').innerText = `${data.count}`;
		  });
		}
	</script>
}
