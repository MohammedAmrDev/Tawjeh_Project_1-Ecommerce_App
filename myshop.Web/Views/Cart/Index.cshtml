@using myshop.Models.DTOs
@model List<CartItemResponse>


<div class="container py-5">
    <h2 class="mb-4">Shopping Cart</h2>
    <div class="row">
        <div class="col-lg-8" id="cart-container">
            <!-- Cart Items -->
            @foreach (var item in Model)
            {
                <div class="cart-item card d-flex flex-row align-items-center p-2 mb-3">
                     <div class="">
                        <img src="@item.ImageURL" class="img-fluid rounded" style="max-width: 100px;height: auto;">
                     </div>
                    <div class="" style="margin-left:24px;">
                        <h5 class="card-title">@item.ProductName</h5>
                        <p class="fw-bold">$@item.Price</p>
                     </div>
                     <div class="text-center" style="margin-left:auto;">
                        <div class="input-group">
                           <button class="btn btn-outline-secondary btn-sm" type="button" onclick="decreaseQuantity(event, @item.ProductId)">-</button>
                           <input style="max-width:100px;width: 50px;" type="text" class="form-control  form-control-sm text-center" value="@item.Quantity">
                           <button class="btn btn-outline-secondary btn-sm" type="button" onclick="increaseQuantity(event, @item.ProductId)">+</button>
                        </div>
                        <button class="btn btn-sm btn-danger mt-3" onclick="removeFromCart(event, @item.ProductId)">
                           <i class="fa fa-trash"></i>
                        </button>
                     </div>
               </div>
            }
            <!-- Continue Shopping Button -->
           <div class="text-start mb-4 col-lg-8">
                  <a asp-controller="Home" asp-action="Index" class="btn btn-outline-primary">Continue Shopping</a>
                  @if (Model.Count >= 1) { <button class="btn btn-outline-danger" onclick="clearCart()">Clear Cart</button> }
            </div>
        </div>

        <div class="col-lg-4">
            <!-- Cart Summary -->
            <div class="card" style="background-color: #f8f9fa;border-radius: 10px;">
                <div class="card-body">
                    <h5 class="card-title mb-4">Order Summary</h5>
                    <div class="d-flex justify-content-between mb-3">
                        <span>Subtotal</span>
                        <span id="total-cart-price">$@(Convert.ToDouble(ViewData["totalPrice"]).ToString("F2"))</span>
                    </div>
                    <div class="d-flex justify-content-between mb-3">
                        <span>Shipping</span>
                        <span>$0.00</span>
                    </div>
                    <div class="d-flex justify-content-between mb-3">
                        <span>Tax</span>
                        <span>$0.00</span>
                    </div>
                    <hr>
                    <div class="d-flex justify-content-between mb-4">
                        <strong>Total</strong>
                        <strong id="total-bill">$@(Convert.ToDouble(ViewData["totalPrice"]).ToString("F2"))</strong>
                    </div>
                    <button class="btn btn-primary w-100">Proceed to Checkout</button>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        function increaseQuantity(event, id) {
            fetch(`/Cart/IncreaseQuantity?id=${id}`, {
               method: 'POST',
            }).then(response => {
               if (!response.ok) console.error(response.status);
               return response.json();
            }).then(data => {
               event.target.previousElementSibling.value = data.quantity;
               updateCartBill(data.totalPrice, 0, 0);
            });
         }

        function decreaseQuantity(event, id) {
           fetch(`/Cart/DecreaseQuantity?id=${id}`, {
              method: 'POST',
           }).then(response => {
              if (!response.ok) console.error(response.status);
              return response.json();
           }).then(data => {
              if (data.quantity === 0) {
                  removeFromCart(event, id);
              } else {
                  event.target.nextElementSibling.value = data.quantity;
                  updateCartBill(data.totalPrice, 0, 0);
              }
           });
        }

        function removeFromCart(event, id) {
            Swal.fire({
               title: 'Are you sure?',
               text: "You won't be able to revert this!",
               icon: 'warning',
               showCancelButton: true,
               confirmButtonColor: '#3085d6',
               cancelButtonColor: '#d33',
               confirmButtonText: 'Yes, delete it!'
            }).then((result) => {
               if (result.isConfirmed) {
                  fetch(`/Cart/Delete?id=${id}`, {
                     method: 'DELETE',
                  }).then(response => {
                     if (!response.ok) console.error(response.status);
                     return response.json();
                  }).then(data => {
                     if (data.success) {
                        event.target.closest(".card").remove();
                        updateCartBill(data.totalPrice, 0, 0);
                     }
                  })
               }
            });
            }

            function clearCart() {
               Swal.fire({
                  title: 'Are you sure?',
                  text: "You won't be able to revert this!",
                  icon: 'warning',
                  showCancelButton: true,
                  confirmButtonColor: '#3085d6',
                  cancelButtonColor: '#d33',
                  confirmButtonText: 'Yes, clear cart!'
               }).then((result) => {
                  if (result.isConfirmed) {
                     fetch(`/Cart/Clear`, {
                        method: 'DELETE',
                     }).then(response => {
                        if (!response.ok) console.error(response.status);
                        return response.json();
                     }).then(data => {
                           document.querySelectorAll("#cart-container .cart-item").forEach(el => el.remove());
                           updateCartBill(data.totalPrice, 0, 0);
                     });
                  }
               });
            }

            function updateCartBill(cartPrice, shipping, taxes) {
               document.getElementById("total-cart-price").textContent = "$" + cartPrice.toFixed(2);
               document.getElementById("total-bill").textContent = "$" + ((cartPrice + shipping) * (1 - taxes)).toFixed(2);
            }
    </script>
}